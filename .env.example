# Copy this file to .env and fill in your Supabase project values.
# These are read by Vite at build time. The anon key is safe in client JS.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Server-side secrets (do NOT add to this file).
# Set with: supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   ANTHROPIC_API_KEY     — ai-coach and generate-program
#   EXERCISE_GIF_API_KEY  — exercise-gif (RapidAPI key; unset = animations off).
#                           Generate a NEW key for this: any key that was ever
#                           set as VITE_EXERCISE_GIF_API is in every past
#                           bundle, and old Vercel deployment URLs keep
#                           serving those. Revoke it on RapidAPI.
#
# Scripts only, exported in the shell that runs them (never VITE_-prefixed,
# never in .env, which Vite inlines into the public bundle):
#   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY — scripts/clips/ingest.ts
#
# Never add a VITE_ variable for a secret: Vite inlines every VITE_ value into
# the public bundle. The exercise-GIF key used to ship that way.
